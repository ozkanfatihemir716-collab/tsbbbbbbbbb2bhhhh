-- ==================== SHINE ====================
local activeShines = {}

local function createShineOverlay(parent, cornerRadius, shineDuration)
    shineDuration = shineDuration or 2.2
    local shine = Instance.new("Frame")
    shine.Name = "ShineFX"
    shine.Size = UDim2.new(1, 0, 1, 0)
    shine.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
    shine.BorderSizePixel = 0
    shine.ZIndex = 10
    shine.Active = false
    shine.Parent = parent

    if cornerRadius then
        Instance.new("UICorner", shine).CornerRadius = cornerRadius
    end

    local grad = Instance.new("UIGradient", shine)
    grad.Rotation = 25
    grad.Color = ColorSequence.new(Color3.fromRGB(255, 255, 255))
    grad.Transparency = NumberSequence.new({
        NumberSequenceKeypoint.new(0, 1),
        NumberSequenceKeypoint.new(0.40, 1),
        NumberSequenceKeypoint.new(0.50, 0.15),
        NumberSequenceKeypoint.new(0.60, 1),
        NumberSequenceKeypoint.new(1, 1),
    })
    grad.Offset = Vector2.new(-1.3, 0)

    table.insert(activeShines, {shine = shine, grad = grad, duration = shineDuration, active = true})
    return shine
end

RunService.Heartbeat:Connect(function(dt)
    for i = #activeShines, 1, -1 do
        local data = activeShines[i]
        if not data.shine.Parent then
            table.remove(activeShines, i)
        elseif data.active then
            data.grad.Offset = data.grad.Offset + Vector2.new(dt / data.duration * 2.6, 0)
            if data.grad.Offset.X > 1.3 then
                data.grad.Offset = Vector2.new(-1.3, 0)
                data.active = false
                task.delay(1.8, function()
                    if data.shine.Parent then data.active = true end
                end)
            end
        end
    end
end)

