local function ApplyAutoSettings()
    if not Settings.AutoAdjust then
        Settings._BoostWalk = 1.0
        Settings._BoostJump = 1.0
        Settings._BoostHitbox = 1.0
        return
    end
    if IS_MOBILE then
        Settings._BoostWalk = 1.15
        Settings._BoostJump = 1.10
        Settings._BoostHitbox = 1.0
    else
        if fps < 30 then
            Settings._BoostWalk = 1.10
            Settings._BoostJump = 1.05
            Settings._BoostHitbox = 1.0
        else
            Settings._BoostWalk = 1.25
            Settings._BoostJump = 1.20
            Settings._BoostHitbox = 1.15
        end
    end
end
