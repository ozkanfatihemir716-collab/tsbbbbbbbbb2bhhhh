        ColorSequenceKeypoint.new(0, preset.c1),
        ColorSequenceKeypoint.new(1, preset.c2)
    }

    local pStroke2 = Instance.new("UIStroke", preview)
    pStroke2.Thickness = 1
    pStroke2.Color = Color3.fromRGB(60, 50, 80)

    -- Beyaz okunabilir yazı
    local pLbl = Instance.new("TextLabel", pbtn)
    pLbl.Size = UDim2.new(1, -40, 1, 0)
    pLbl.Position = UDim2.new(0, 38, 0, 0)
    pLbl.BackgroundTransparency = 1
    pLbl.TextColor3 = Color3.fromRGB(240, 240, 250)
    pLbl.Font = Enum.Font.GothamBold
    pLbl.TextSize = 11
    pLbl.TextXAlignment = Enum.TextXAlignment.Left
    regText(pLbl, preset.key)

    pbtn.MouseButton1Click:Connect(function()
        Settings.Color1 = preset.c1
        Settings.Color2 = preset.c2
        Settings.Color3 = preset.c3
        ApplyTheme()
        for _, d in pairs(espData) do
            if d.highlight and d.highlight.Parent then
                d.highlight.FillColor = Settings.Color2
                d.highlight.OutlineColor = Settings.Color2
            end
            if d.label and d.label.Parent then
                d.label.TextColor3 = Settings.Color2
            end
        end
    end)
end

