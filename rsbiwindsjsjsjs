local AllToggles = {}

local function CreateToggle(parent, textKey, emoji, callback, defaultState)
    local btn = Instance.new("TextButton", parent)
    btn.Size = UDim2.new(1, 0, 0, 42)
    btn.BackgroundColor3 = Color3.fromRGB(22, 17, 32)
    btn.Text = ""
    btn.BorderSizePixel = 0
    Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 10)

    local btnStroke = Instance.new("UIStroke", btn)
    btnStroke.Thickness = 1
    btnStroke.Color = Color3.fromRGB(45, 35, 60)

    local iconLbl = Instance.new("TextLabel", btn)
    iconLbl.Size = UDim2.new(0, 34, 1, 0)
    iconLbl.Position = UDim2.new(0, 6, 0, 0)
    iconLbl.BackgroundTransparency = 1
    iconLbl.Text = emoji
    iconLbl.TextColor3 = Color3.fromRGB(255, 255, 255)
    iconLbl.Font = Enum.Font.GothamBold
    iconLbl.TextSize = 18

    local txtLbl = Instance.new("TextLabel", btn)
    txtLbl.Size = UDim2.new(1, -70, 1, 0)
    txtLbl.Position = UDim2.new(0, 42, 0, 0)
    txtLbl.BackgroundTransparency = 1
    txtLbl.TextColor3 = Color3.fromRGB(200, 195, 220)
    txtLbl.Font = Enum.Font.GothamBold
    txtLbl.TextSize = 12
    txtLbl.TextXAlignment = Enum.TextXAlignment.Left
    regText(txtLbl, textKey)

    local status = Instance.new("Frame", btn)
    status.Size = UDim2.new(0, 10, 0, 10)
    status.Position = UDim2.new(1, -22, 0.5, -5)
    status.BackgroundColor3 = Color3.fromRGB(60, 50, 80)
    Instance.new("UICorner", status).CornerRadius = UDim.new(1, 0)

    local state = defaultState or false
    local function updateV()
        if state then
            btn.BackgroundColor3 = Color3.fromRGB(35, 22, 55)
            btnStroke.Color = Settings.Color1
            txtLbl.TextColor3 = Color3.fromRGB(255, 255, 255)
            status.BackgroundColor3 = Settings.Color2
        else
            btn.BackgroundColor3 = Color3.fromRGB(22, 17, 32)
            btnStroke.Color = Color3.fromRGB(45, 35, 60)
            txtLbl.TextColor3 = Color3.fromRGB(200, 195, 220)
            status.BackgroundColor3 = Color3.fromRGB(60, 50, 80)
        end
    end

    btn.MouseButton1Click:Connect(function()
        state = not state
        updateV()
        if callback then callback(state) end
    end)
    updateV()

    table.insert(AllToggles, {btn = btn, stroke = btnStroke, icon = iconLbl, status = status, txt = txtLbl, updateV = updateV})
end

