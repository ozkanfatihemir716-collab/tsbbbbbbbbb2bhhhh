local function createSlider(parent, labelKey, minV, maxV, currentVal, callback)
    local row = Instance.new("Frame", parent)
    row.Size = UDim2.new(1, -10, 0, 44)
    row.BackgroundColor3 = Color3.fromRGB(22, 17, 32)
    row.BorderSizePixel = 0
    Instance.new("UICorner", row).CornerRadius = UDim.new(0, 8)

    local lbl = Instance.new("TextLabel", row)
    lbl.Size = UDim2.new(1, -20, 0, 18)
    lbl.Position = UDim2.new(0, 10, 0, 4)
    lbl.BackgroundTransparency = 1
    lbl.TextColor3 = Color3.fromRGB(220, 210, 240)
    lbl.Font = Enum.Font.GothamBold
    lbl.TextSize = 10
    lbl.TextXAlignment = Enum.TextXAlignment.Left
    local baseText = L(labelKey)
    lbl.Text = baseText .. ": " .. (math.floor(currentVal * 10) / 10)
    table.insert(TextRefs, {el = lbl, key = labelKey, isSlider = true, suffix = ": " .. (math.floor(currentVal * 10) / 10)})

    local dn = Instance.new("TextButton", row)
    dn.Size = UDim2.new(0, 50, 0, 20)
    dn.Position = UDim2.new(0, 10, 0, 22)
    dn.BackgroundColor3 = Color3.fromRGB(80, 30, 60)
    dn.Text = "−"
    dn.TextColor3 = Color3.new(1, 1, 1)
    dn.Font = Enum.Font.GothamBold
    dn.TextSize = 14
    Instance.new("UICorner", dn).CornerRadius = UDim.new(0, 5)

    local up = Instance.new("TextButton", row)
    up.Size = UDim2.new(0, 50, 0, 20)
    up.Position = UDim2.new(1, -60, 0, 22)
    up.BackgroundColor3 = Color3.fromRGB(40, 80, 60)
    up.Text = "+"
    up.TextColor3 = Color3.new(1, 1, 1)
    up.Font = Enum.Font.GothamBold
    up.TextSize = 14
    Instance.new("UICorner", up).CornerRadius = UDim.new(0, 5)

    local step = (maxV - minV) / 20
    dn.MouseButton1Click:Connect(function()
        currentVal = math.max(minV, currentVal - step)
        lbl.Text = L(labelKey) .. ": " .. (math.floor(currentVal * 10) / 10)
        callback(currentVal)
    end)
    up.MouseButton1Click:Connect(function()
        currentVal = math.min(maxV, currentVal + step)
        lbl.Text = L(labelKey) .. ": " .. (math.floor(currentVal * 10) / 10)
        callback(currentVal)
    end)
end

