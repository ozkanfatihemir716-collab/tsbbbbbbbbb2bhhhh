-- ==================== GELİŞMİŞ FPS BOOSTER (DÜŞÜK CİHAZ) ====================
local function advancedFPSBooster()
    -- 1. Grafik ayarlarını en düşüğe çek
    pcall(function()
        settings().Rendering.QualityLevel = Enum.QualityLevel.Level01
        settings().Rendering.MeshPartDetailLevel = Enum.MeshPartDetailLevel.Level01
        settings().Rendering.EffectsQuality = Enum.QualityLevel.Level01
    end)

    -- 2. Lighting optimizasyonu
    pcall(function()
        Lighting.GlobalShadows = false
        Lighting.FogEnd = 100000
        Lighting.Brightness = 1
        Lighting.EnvironmentDiffuseScale = 0
        Lighting.EnvironmentSpecularScale = 0
        Lighting.ShadowSoftness = 0
        Lighting.Outlines = false
        Lighting.Technology = Enum.Technology.Compatibility
    end)

    -- 3. Atmosfer/efekt katmanlarını kaldır
    pcall(function()
        for _, v in pairs(Lighting:GetChildren()) do
            if v:IsA("Atmosphere") or v:IsA("BloomEffect") or v:IsA("BlurEffect") or
               v:IsA("ColorCorrectionEffect") or v:IsA("SunRaysEffect") or
               v:IsA("DepthOfFieldEffect") then
                v.Enabled = false
            end
        end
    end)

    -- 4. Dünya objelerini optimize et
    local count = 0
    for _, v in pairs(game:GetDescendants()) do
        -- Parçalar
        if v:IsA("BasePart") then
            pcall(function()
                v.Material = Enum.Material.SmoothPlastic
                if v:IsA("MeshPart") then
                    v.RenderFidelity = Enum.RenderFidelity.Performance
                    v.TextureID = ""
                end
                if v:IsA("Part") and v.Shape == Enum.PartType.Ball then
                    v.Shape = Enum.PartType.Block
                end
            end)
            count = count + 1
        -- Parçacık / efekt sistemleri
        elseif v:IsA("ParticleEmitter") or v:IsA("Smoke") or v:IsA("Fire") or
               v:IsA("Sparkles") or v:IsA("Trail") or v:IsA("Beam") or
               v:IsA("Explosion") or v:IsA("Fire") then
            pcall(function() v.Enabled = false end)
        -- Decal / Texture
        elseif v:IsA("Decal") or v:IsA("Texture") then
            pcall(function() v.Transparency = 1 end)
        -- Gölge
        elseif v:IsA("Shirt") or v:IsA("Pants") then
            pcall(function() v:Destroy() end)
        end
    end

    -- 5. Karakter parçalarının gölgelerini kapat
    for _, p in pairs(Players:GetPlayers()) do
        if p.Character then
            for _, part in pairs(p.Character:GetDescendants()) do
                if part:IsA("BasePart") then
                    pcall(function() part.CastShadow = false end)
                end
            end
        end
    end
end

